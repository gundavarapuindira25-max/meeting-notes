# Runs against local Ollama models — no API key needed.
# Install: brew install ollama && ollama pull llama3.2:3b && ollama pull qwen2.5:7b && ollama pull nomic-embed-text
# Then make sure the Ollama server is running (brew services start ollama,
# or `ollama serve`) before starting the backend.
OLLAMA_HOST=http://localhost:11434

# Single-shot transcript summarization — a smaller model is fine here.
OLLAMA_MODEL=llama3.2:3b

# The ask-a-question agent (multi-step tool calling). Needs a larger model
# than the summarizer: testing showed a 3B model unreliably chains two tool
# calls together on some question phrasings, qwen2.5:7b doesn't have that
# problem. See the comment in backend/agent.py for the specific failure mode.
OLLAMA_AGENT_MODEL=qwen2.5:7b

# Used for RAG search across meeting history (the "Ask" feature).
OLLAMA_EMBED_MODEL=nomic-embed-text
